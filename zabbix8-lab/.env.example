# Copie para .env e ajuste conforme necessário: cp .env.example .env
COMPOSE_PROJECT_NAME=zabbix8-lab

# Zabbix 8.0 ainda é publicado apenas como trunk no Docker Hub
ZBX_IMAGE_TAG=alpine-trunk
POSTGRES_IMAGE_TAG=17-alpine
CLICKHOUSE_IMAGE_TAG=26.8
OTEL_COLLECTOR_IMAGE_TAG=0.163.2

# Diretório no host onde os dados persistentes ficam
DATA_DIRECTORY=./data

# Portas publicadas no host
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051
ZABBIX_PROXY_PORT=10061
ZABBIX_PROXY_OTLP_PORT=14317
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
MCP_SERVER_PORT=8443
CLICKHOUSE_HTTP_PORT=8123
SHOP_APP_PORT=3001
