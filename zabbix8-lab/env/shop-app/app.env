# Usuários de teste da loja, no formato usuario:senha separados por vírgula
SHOP_USERS=cliente:cliente123,maria:maria123,joao:joao123

# Simulação de falhas e lentidão (0 a 1). Cartão recusa mais que Pix e boleto.
PAYMENT_FAILURE_RATE=0.1
SLOW_CHECKOUT_RATE=0.05

# Reabastece o estoque de todos os produtos a cada N minutos (0 desliga)
RESTOCK_INTERVAL_MINUTES=30

OTEL_SERVICE_NAME=zabbix-shop-demo
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Contadores e histogramas em delta: cada ponto traz só o incremento do período,
# o que permite ao Zabbix somar (sum) os valores numa janela do Telemetry query.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
