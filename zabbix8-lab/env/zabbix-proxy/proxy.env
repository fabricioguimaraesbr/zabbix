# Proxy ativo: cadastre no frontend um proxy com este mesmo nome
ZBX_PROXYMODE=0
ZBX_HOSTNAME=zabbix-proxy-otel
ZBX_SERVER_HOST=zabbix-server:10051
ZBX_DEBUGLEVEL=3
ZBX_CONFIGFREQUENCY=60

# Receptor OTLP gRPC nativo (APM collector)
ZBX_STARTAPMCOLLECTORS=1
ZBX_APMLISTENIP=0.0.0.0
ZBX_APMLISTENPORT=4317
ZBX_STARTTELEMETRYQUERYPOLLERS=1
