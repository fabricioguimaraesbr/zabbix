# Ambiente DEV (laboratório pessoal)
# Copie para config/dev.env e ajuste. O arquivo dev.env não é versionado.
#   cp config/dev.env.example config/dev.env

# --- Geral ---
TZ=America/Sao_Paulo
DOCKER_NETWORK=zabbix-network
# Pasta onde os volumes persistentes são gravados (relativa a Docker/ ou caminho absoluto)
DATA_DIR=./data

# --- Versões das imagens ---
ZBX_IMAGE_TAG=alpine-trunk
ZBX_VERSION=8.0
POSTGRES_IMAGE_TAG=17-alpine
CLICKHOUSE_IMAGE_TAG=latest
GRAFANA_IMAGE_TAG=latest
OTEL_COLLECTOR_IMAGE_TAG=latest

# --- Banco do Zabbix (PostgreSQL) ---
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# --- ClickHouse ---
CLICKHOUSE_DB=zabbix
CLICKHOUSE_USER=zabbix
CLICKHOUSE_PASSWORD=troque-esta-senha
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# --- Zabbix Server / Frontend / Agent ---
ZBX_SERVER_NAME=Zabbix DEV
ZBX_SERVER_PORT=10051
ZBX_WEB_HTTP_PORT=80
ZBX_WEB_HTTPS_PORT=443
ZBX_AGENT_HOSTNAME=Zabbix server
ZBX_AGENT_PORT=10050

# --- Grafana ---
GRAFANA_PORT=3000

# --- Proxy APM (docker-compose-app.yml) ---
# Nome cadastrado no frontend do Zabbix como proxy ativo
ZBX_PROXY_HOSTNAME=zabbix-apm-proxy
# Zabbix Server para o qual o proxy envia os dados
ZBX_PROXY_SERVER=zabbix-server
ZBX_PROXY_APM_PORT=4317

# --- Aplicação demonstrativa ---
APP_PORT=8080
APP_USERNAME=demo
APP_PASSWORD=troque-esta-senha
# Mínimo de 32 caracteres. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
OTEL_SERVICE_NAME=zabbix-login-demo
