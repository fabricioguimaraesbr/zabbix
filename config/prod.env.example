# Ambiente PROD (corporativo)
# Este arquivo contém apenas os NOMES das variáveis e placeholders.
# Os valores reais são preenchidos somente no ambiente corporativo
# (config/prod.env, nunca versionado neste repositório pessoal).
#   cp config/prod.env.example config/prod.env

# --- Geral ---
TZ=America/Sao_Paulo
DOCKER_NETWORK=zabbix-network
DATA_DIR=/caminho/para/volumes

# --- Versões das imagens (em produção, prefira tags fixas, nunca latest/trunk) ---
ZBX_IMAGE_TAG=<tag-fixa-do-zabbix>
ZBX_VERSION=<versao-do-zabbix>
POSTGRES_IMAGE_TAG=<tag-fixa>
CLICKHOUSE_IMAGE_TAG=<tag-fixa>
GRAFANA_IMAGE_TAG=<tag-fixa>
OTEL_COLLECTOR_IMAGE_TAG=<tag-fixa>

# --- Banco do Zabbix (PostgreSQL) ---
ZABBIX_DB_NAME=<nome-do-banco>
ZABBIX_DB_USER=<usuario>
ZABBIX_DB_PASSWORD=<senha-do-cofre>
POSTGRES_PORT=5432

# --- ClickHouse ---
CLICKHOUSE_DB=<nome-do-banco>
CLICKHOUSE_USER=<usuario>
CLICKHOUSE_PASSWORD=<senha-do-cofre>
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# --- Zabbix Server / Frontend / Agent ---
ZBX_SERVER_NAME=<nome-exibido-no-frontend>
ZBX_SERVER_PORT=10051
ZBX_WEB_HTTP_PORT=80
ZBX_WEB_HTTPS_PORT=443
ZBX_AGENT_HOSTNAME=<hostname-do-agent>
ZBX_AGENT_PORT=10050

# --- Grafana ---
GRAFANA_PORT=3000

# --- Proxy APM ---
ZBX_PROXY_HOSTNAME=<nome-do-proxy-no-frontend>
ZBX_PROXY_SERVER=<host-do-zabbix-server-corporativo>
ZBX_PROXY_APM_PORT=4317

# --- Aplicação demonstrativa (normalmente não vai para produção) ---
APP_PORT=8080
APP_USERNAME=<usuario>
APP_PASSWORD=<senha-do-cofre>
SESSION_SECRET=<segredo-do-cofre>
OTEL_SERVICE_NAME=<nome-do-servico>
